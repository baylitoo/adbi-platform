# ADBI Coffre — variables d'environnement.
ADBI_COFFRE_PORT=4300

# ── Contrôle d'accès (#245) ───────────────────────────────────────────────────
# Le coffre était entièrement public : quiconque atteignait son domaine pouvait
# chiffrer, déchiffrer, lister les références et télécharger les documents
# archivés. Ces variables le ferment. docker-compose.yml doit les transmettre :
# les poser ici sans la ligne correspondante dans le compose ne les fait jamais
# arriver dans le conteneur (même piège que #164).
#
# ADBI_AUTH absent/off = comportement d'avant, à l'octet : accès libre sous
# l'identité locale (poste de dev hors ligne). Posé à "on", le coffre exige une
# session émise par cv-parser — seul émetteur d'identité de la plateforme — et
# VÉRIFIÉE ici avec le même secret. Le coffre ne signe jamais de jeton.
ADBI_AUTH=
# Exactement la même valeur que cv-parser, sinon toute session est refusée.
# ADBI_AUTH=on SANS ce secret = refus de tout, jamais passage libre : une
# variable oubliée doit être une panne visible, pas une ouverture silencieuse.
ADBI_JWT_SECRET=
# URL publique du hub, ex. https://hub.exemple.test
# Le coffre est affiché dans une <iframe> du hub : un visiteur sans session
# reçoit une page qui renvoie le NIVEAU SUPÉRIEUR vers le hub, seul capable de
# renouveler la session (une redirection sur place ferait un cadre mort à
# l'expiration du jeton, au bout d'une heure). Vide : réponse 401 en clair,
# sans cible de reconnexion.
ADBI_FACTORY_URL=
