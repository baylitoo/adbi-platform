# Plateforme ADBI — variables pour `docker compose up` (racine du dépôt).
# cp .env.example .env, puis renseigner AU MINIMUM les variables marquées
# REQUIS ci-dessous — docker-compose.yml refuse de démarrer sans elles.
#
# Liste complète des variables optionnelles de chaque service : voir le
# .env.example de son dossier (contrats/, cv-parser/, coffre/, one-pager/,
# factory/) — ce fichier ne reprend que ce que docker-compose.yml consomme.

# ── REQUIS — base PostgreSQL partagée (une base par service, voir
# infra/postgres/init-databases.sh). Générer un vrai mot de passe :
#   openssl rand -hex 24
POSTGRES_USER=adbi
POSTGRES_PASSWORD=

# ── REQUIS — contrats ─────────────────────────────────────────────────────────
# Code d'accès à l'écran Paramètres (clés API, modèles, corbeille). Générer
# une vraie valeur, ne jamais réutiliser celle d'un autre environnement.
ADBI_CODE_PARAMETRES=

# ── REQUIS — cv-parser ────────────────────────────────────────────────────────
# Secret de signature des sessions (JWT). Générer par ex. avec :
#   openssl rand -hex 32
ADBI_JWT_SECRET=
# Identifiants du superuser créé au tout premier démarrage.
ADBI_SUPERUSER_EMAIL=
ADBI_SUPERUSER_PASSWORD=

# ── Optionnel — portée de la session ADBI (issue #245, série contrôle d'accès)
#
# VIDE = comportement actuel, à l'octet : le cookie de session reste
# « host-only », renvoyé au seul cv-parser. Un déploiement qui ne pose pas ces
# deux variables ne voit aucun changement.
#
# ADBI_COOKIE_DOMAIN : domaine parent du cookie, pour que les autres services
# ADBI puissent VÉRIFIER le jeton émis par cv-parser (cv-parser reste le seul
# émetteur d'identité). Ne jamais poser un suffixe public ni au-dessus — le
# navigateur refuserait le cookie.
#   domaine propre  : outils.adbi.fr
#   domaines Coolify generes : <ip-du-serveur>.sslip.io — fonctionne, mais le
#   cookie devient visible par tout hôte servi sous ce suffixe ; c'est
#   exactement ce que la bascule de domaine (#253) referme.
ADBI_COOKIE_DOMAIN=
# ADBI_FACTORY_URL : URL publique du hub, ex. https://outils.adbi.fr
# Sert UNIQUEMENT à valider le `next` de /login. Sans elle, aucun `next` n'est
# accepté et la connexion retombe sur « / » — une page de connexion qui
# redirige vers une URL arbitraire est une redirection ouverte à l'endroit le
# plus dangereux qui soit.
ADBI_FACTORY_URL=

# ── Optionnel — passerelle d'inférence interne ADBI (cv-parser + voyant IA
# du hub) — voir cv-parser/README.md et factory/README.md. Sans elle, pas
# d'IA complémentaire ; l'extraction CV utilise DOCIE_BASE_URL séparément.
ADBI_LLM_BASE_URL=
ADBI_LLM_API_KEY=
ADBI_LLM_MODEL=
ADBI_LLM_MODELS=

# ── Optionnel — contrats : recherche société, SMTP, signature électronique.
# Détail de chaque variable : contrats/.env.example
PAPPERS_API_KEY=
INSEE_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
YOUSIGN_API_KEY=
YOUSIGN_MODE=sandbox
YOUSIGN_WEBHOOK_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REGION=eu
## Extraction CV via DocIE (URL racine, sans /v1).
# Docker Desktop / service sur l'hôte : http://host.docker.internal:8080
# Exécution native : http://127.0.0.1:8080
DOCIE_BASE_URL=
DOCIE_API_KEY=
DOCIE_EXTRACTION_MODE=inline
# Only used in legacy studio mode; inline sends the bundled adbi_resume schema.
DOCIE_SCHEMA_NAME=resume
DOCIE_MODEL_PROFILE=
DOCIE_OCR_BACKEND=
DOCIE_TIMEOUT_SECONDS=900
## Modèles proposés par action (#194, document-parsing/models/catalogue.json) :
## identifiant réel de chaque modèle sur la voie texte (`store:<nom>`, lu sur
## GET /v1/serving/store). Vide = modèle non proposé ; tous vides = comportement
## d'avant. Lus par contrats, cv-parser et one-pager (voir leurs .env.example).
## NuExtract3 : TOUJOURS une référence `store:<nom>`. Le déploiement `store:`
## hérite du `max_tokens` 16384 de DocIE (#523) ; le profil nommé `nuextract3`
## de models.yaml fixe encore 4096 et tronquerait un grand CV ou contrat
## (finish_reason: length).
DOCIE_MODELE_NUEXTRACT3=
DOCIE_MODELE_LFM25_2_6B=
DOCIE_MODELE_LFM25_350M=

## Optionnel — OpenAI, modèle d'extraction EXTERNE (hors ADBI, #194). Choix
## explicite de l'utilisateur seulement, jamais un repli : un échec OpenAI
## s'affiche tel quel. Clé non vide = « OpenAI rapide » et « OpenAI
## raisonnement » proposés en plus des modèles DocIE, jamais par défaut, pour
## contrat, Kbis, URSSAF, attestation fiscale et RIB (voie texte seulement ;
## jamais pour les CV). Clé vide = rien n'est proposé.
## Protection des données : OpenAI devient un sous-traitant externe, le TEXTE du
## document lui est envoyé (jamais un PDF ni une image). Requêtes en
## `store: false` (sans lui, la Responses API conserve 30 jours) ; OpenAI garde
## néanmoins ses journaux de surveillance des abus jusqu'à 30 jours, sauf accord
## de conservation zéro (ZDR). Traitement en UE (https://eu.api.openai.com) :
## seulement sur accord d'OpenAI (résidence des données), avec +10 % sur les
## modèles sortis à partir du 2026-03-05 (les modèles ci-dessous sont
## antérieurs). Source : developers.openai.com/api/docs/guides/your-data, lue le
## 2026-09-16.
## Transmises au seul service `contrats` (#226) : c'est lui qui porte le
## sélecteur de modèle des pièces. cv-parser et one-pager ne les reçoivent pas —
## les CV ne partent jamais chez un fournisseur externe.
OPENAI_API_KEY=
## Racine de l'API, sans /v1 (vide = https://api.openai.com).
OPENAI_BASE_URL=
## Mode rapide, sans raisonnement : gpt-4.1-nano (vide = défaut) ou gpt-4.1-mini.
OPENAI_MODELE_RAPIDE=
## Mode raisonnement (reasoning.effort « low ») : gpt-5-nano (vide = défaut, seul permis).
OPENAI_MODELE_RAISONNEMENT=
## Délai en secondes (1 à 3600) ; vide = DOCIE_TIMEOUT_SECONDS, sinon 360.
OPENAI_TIMEOUT_SECONDS=
## Tarifs lus le 2026-09-16 sur les pages modèles de developers.openai.com, par
## million de jetons (entrée / sortie) : gpt-4.1-nano 0,10 $ / 0,40 $ ;
## gpt-4.1-mini 0,40 $ / 1,60 $ ; gpt-5-nano 0,05 $ / 0,40 $, jetons de
## raisonnement facturés comme jetons de sortie.

## Bascules vers le bridge DocIE partagé (issue #150/#155) — UNE variable
## racine par service, pour pouvoir valider/activer chacun indépendamment
## sans basculer les autres en même temps. Toutes à false par défaut : le
## comportement actuel (docie_client.py / extraction propre / OCR local)
## reste inchangé tant qu'aucune n'est mise à true.

## cv-parser (issue #151) : docie_client.py (ci-dessus) reste le chemin
## d'extraction actif tant que cette variable est absente/false.
CVPARSER_DOCIE_EXTRACTION_ENABLED=false
# Requis seulement si CVPARSER_DOCIE_EXTRACTION_ENABLED=true : nom de l'agent
# DocIE côté bridge (document-parsing/bridge/docie_bridge.py).
DOCIE_AGENT_RESUME=
## Modèles proposés pour les CV, voie agent (#194) : un agent par modèle, lus
## par cv-parser et one-pager (voir leurs .env.example). Voie texte :
## DOCIE_MODELE_<MODELE> (document-parsing/models/catalogue.json).
DOCIE_AGENT_RESUME_LFM25_2_6B=
DOCIE_AGENT_RESUME_NUEXTRACT3=
# Dérogation explicite si DOCIE_BASE_URL est en HTTP hors loopback (ex.
# host.docker.internal en local) : le bridge refuse HTTP par défaut.
DOCIE_ALLOW_HTTP=

## one-pager (issue #152) : voir one-pager/.env.example pour le détail.
ONEPAGER_DOCIE_EXTRACTION_ENABLED=false

## contrats (issues #153, #170, #194) : Kbis, contrat, URSSAF, RIB et attestation
## fiscale — le comportement local (pdf-parse/tesseract.js) reste le repli.
## Réutilise DOCIE_BASE_URL/DOCIE_API_KEY ci-dessus. Voir
## contrats/lib/docie-extraction.js, contrats/lib/docie-contract-import.js et
## contrats/.env.example.
CONTRATS_DOCIE_EXTRACTION_ENABLED=false
DOCIE_AGENT_KBIS=
## Agent DocIE du schéma "contract" : pré-remplissage de l'import
## (/api/contracts/importer/extraire) quand AUCUN modèle n'est choisi — ce
## chemin-là passe par la voie agent, où le pont exige DOCIE_AGENT_<TACHE> et
## échoue en `configuration` s'il est vide. Déjà transmis par les trois composes
## et documenté dans contrats/.env.example ; c'est ce fichier-ci, que docker lit
## pour les substitutions ${...}, qui l'oubliait. Même piège que #164, en miroir.
DOCIE_AGENT_CONTRACT=
## Kbis « choisi par type d'entrée » (#194) : un PDF à couche texte passe par la
## voie texte dès que DOCIE_MODELE_LFM25_2_6B est renseigné ; une photo ou un
## scan, avec un modèle choisi, par l'agent NuExtract3 ci-dessous (vision,
## 8 pages au plus). Vide = non proposé. Voir contrats/.env.example.
DOCIE_AGENT_KBIS_NUEXTRACT3=

## Extractions DocIE simultanées par service (issue #196) — UNE variable racine
## par service, transmise au conteneur sous le nom commun
## ADBI_EXTRACTION_MAX_CONCURRENT. À aligner sur le `n_parallel` du modèle servi
## pour ce service (liste retenue de #194) : au-delà, la requête admise attend
## dans llama-server et cette attente compte dans DOCIE_TIMEOUT_SECONDS. Vide ->
## défaut du service ; entier de 1 à 16, toute autre valeur empêche le service
## de démarrer.
# cv-parser, CV : LFM2.5-2.6B par défaut, n_parallel 2 -> défaut 2.
CVPARSER_EXTRACTION_MAX_CONCURRENT=
# one-pager, CV : LFM2.5-2.6B par défaut, n_parallel 2 -> défaut 2.
ONEPAGER_EXTRACTION_MAX_CONCURRENT=
# contrats, contrats : NuExtract3 par défaut, n_parallel 1 -> défaut 1.
CONTRATS_EXTRACTION_MAX_CONCURRENT=
