# ADBI Factory — variables d'environnement optionnelles.
ADBI_PORT=4000
ADBI_SANS_PRECHAUFFAGE=

# Passerelle d'inférence interne ADBI — DocIE Studio
# (github.com/baylitoo/slm_benchmark), pour le voyant IA du hub UNIQUEMENT
# (/api/llm/chaine, /api/llm/tester dans server.js). La clé reste côté
# serveur ; sans ces variables, le voyant affiche simplement "non configurée".
# ADBI_LLM_BASE_URL : <api Studio>/v1/agents (routage par le champ "model").
ADBI_LLM_BASE_URL=
ADBI_LLM_API_KEY=
# NOMS D'AGENT Studio à tester, séparés par des virgules (ordre = ordre
# d'essai) — pas des identifiants Hugging Face bruts.
ADBI_LLM_MODELS=
