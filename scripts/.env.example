# Copy this file to .env.remote at the repository root (gitignored).
# Edit values here instead of exporting variables in your shell.
# Whole-line comments only. Keys may be quoted; no variable interpolation.

# CHAT: remote model port or OpenAI-compatible pipeline/gateway URL.
# Root URL, /v1 base, or full /v1/chat/completions endpoint accepted.
ADBI_LLM_BASE_URL=https://YOUR-HOST/v1
ADBI_LLM_MODEL=YOUR_LFM_MODEL_ID
ADBI_LLM_API_KEY=

# EXTRACT: DocIE API domain, NOT the raw model port.
# DocIE does LiteParse -> LFM using the selected model profile.
DOCIE_BASE_URL=https://YOUR-DOCIE-HOST
DOCIE_API_KEY=
DOCIE_EXTRACTION_MODE=inline
# Stored schema name is only used with DOCIE_EXTRACTION_MODE=studio.
DOCIE_SCHEMA_NAME=resume
DOCIE_MODEL_PROFILE=YOUR_LFM_PROFILE
DOCIE_OCR_BACKEND=liteparse
DOCIE_TIMEOUT_SECONDS=360
