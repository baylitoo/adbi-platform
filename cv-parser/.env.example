# ADBI Parser — variables d'environnement.

# PostgreSQL — REQUISE (issue #15, PR B) : plus de repli SQLite/JSON.
# En docker-compose (racine du dépôt), déjà câblée vers le service `postgres`.
# En local hors docker, pointer vers une instance PostgreSQL existante.
DATABASE_URL=postgresql://adbi:motdepasse@localhost:5432/adbi_cv_parser

# Secret JWT (session utilisateur). Si absent, généré au premier lancement
# dans data/jwt_secret.txt et réutilisé ensuite — inutile de le fixer ici en
# développement. À fixer explicitement pour un déploiement multi-instance
# (sinon chaque instance signe avec un secret différent).
ADBI_JWT_SECRET=

# Passerelle d'inférence interne ADBI (extraction de CV) — DocIE Studio
# (github.com/baylitoo/slm_benchmark), compatible API OpenAI. Sans
# ADBI_LLM_BASE_URL, aucune IA n'est appelée : l'extraction locale Docling
# reste seule disponible (voir llm_cascade.py::chaine_defaut).
#
# ADBI_LLM_BASE_URL : <api Studio>/v1/agents (routage par le champ "model")
#   ou <api Studio>/v1/agents/<nom-agent> (un seul agent, base dédiée).
# ADBI_LLM_MODEL(S) : le(s) NOM(S) D'AGENT enregistré(s) dans Studio (onglet
#   Agents), pas un identifiant Hugging Face brut — c'est l'agent qui sert de
#   modèle OpenAI, avec ses éventuelles politiques (garde PII, etc.).
ADBI_LLM_BASE_URL=
ADBI_LLM_API_KEY=
ADBI_LLM_MODEL=
# Plusieurs agents à essayer en cascade (séparés par des virgules) — prend
# le pas sur ADBI_LLM_MODEL si renseigné.
ADBI_LLM_MODELS=
# Authentification : désactivée par défaut (poste local). À activer avant
# toute exposition Internet.
#
# cv-parser est le SEUL émetteur d'identité de la plateforme : les quatre
# services Node (factory, coffre, contrats, one-pager) ne font que vérifier le
# jeton qu'il signe, avec le même ADBI_JWT_SECRET. Chacun lit sa propre
# ADBI_AUTH — la poser ici ne protège que cv-parser.
#
# docker-compose.yml pose `ADBI_AUTH: "on"` EN DUR pour ce service : en
# déploiement composé, cette ligne-ci n'est donc pas ce qui décide.
ADBI_AUTH=off
# URL publique du hub, ex. https://hub.exemple.test. Sert UNIQUEMENT à valider
# le `next` de /login, comparé sur son ORIGINE exacte (#254) : sans liste
# blanche, un paramètre de redirection sur une page de connexion est une
# redirection ouverte. Vide = aucun `next` accepté, retour sur "/" après
# connexion — l'utilisateur venu du hub ne revient donc pas au hub.
ADBI_FACTORY_URL=

# Port et interface d'écoute. ADBI_HOTE=127.0.0.1 par défaut (poste local) ;
# l'image Docker le fixe à 0.0.0.0 (voir Dockerfile), sinon le port publié par
# le conteneur ne serait pas joignable.
PORT=5000
ADBI_HOTE=127.0.0.1

# Débogueur Werkzeug : désactivé par défaut (exécution de code arbitraire si
# jamais exposé — voir app.py). Développement local uniquement.
ADBI_DEBUG=off

# Superuser créé au tout premier démarrage (si la table users est vide, voir
# core/auth_pg.py::list_users et core/auth.py::ensure_default_superuser).
# À définir explicitement avant tout déploiement accessible depuis Internet —
# sinon admin@adbi.fr / Adbi2025! (valeurs de développement, voir config.py).
ADBI_SUPERUSER_EMAIL=
ADBI_SUPERUSER_PASSWORD=

# Bornes sur les besoins clients (POST/PATCH /api/needs) — issue #72 : sans
# elles, un besoin sert de vecteur de déni de service (core/matcher.py relit
# ces champs pour chaque CV de la CVthèque à chaque matching). Valeurs par
# défaut confortables pour un usage réel ; à ne resserrer/élargir que si
# besoin (voir config.py).
ADBI_NEED_SHORT_MAX=300
ADBI_NEED_TEXT_MAX=20000
ADBI_NEED_LIST_MAX=60
ADBI_NEED_ITEM_MAX=100

# Bornes sur les fiches CV (POST /api/cvs, PATCH /api/cvs/<id>) — issue #98 :
# même risque, dans l'autre sens (côté candidat plutôt que besoin) —
# core/matcher.py compare chaque compétence du besoin à chaque compétence du
# candidat (SequenceMatcher par paire) sans plafond côté candidat jusqu'ici.
# Valeurs par défaut confortables pour un usage réel (voir config.py).
ADBI_CV_LIST_MAX=300
ADBI_CV_SKILLS_FLAT_MAX=500
# DocIE extrait les CV, OCR compris ; aucune installation Docling/Torch locale.
# URL racine sans /v1. En Docker : http://host.docker.internal:8080
DOCIE_BASE_URL=http://127.0.0.1:8080
DOCIE_API_KEY=
DOCIE_MODEL_PROFILE=
DOCIE_TIMEOUT_SECONDS=360
# Autoriser une URL DocIE en http:// vers un hôte AUTRE que la boucle locale.
# Le pont partagé (document-parsing/bridge/) refuse sinon la configuration,
# code `configuration` : le texte du document partirait en clair.
#
# Devenu nécessaire ici depuis le câblage du .docx sur la voie texte (#151) :
# un .docx passait auparavant par le client historique, qui ne lit pas cette
# variable. Sur un déploiement qui joint DocIE en http://, la laisser vide fait
# désormais échouer l'extraction .docx. La vraie correction est le HTTPS côté
# DocIE ; ceci n'est qu'un aveu explicite, jamais un défaut.
DOCIE_ALLOW_HTTP=
# Modèles HORS ADBI pour l'extraction de CV (#194, #217,
# document-parsing/bridge/openai_responses.py) — voie TEXTE uniquement.
# Proposés dans le sélecteur SI ET SEULEMENT SI OPENAI_API_KEY est non vide :
# clé absente = comportement d'avant à l'octet près. Jamais un défaut, jamais un
# repli — l'externe n'apparaît qu'APRÈS le défaut et l'alternative DocIE, et
# seul un choix explicite l'envoie.
#
# DONNÉES PERSONNELLES : un CV est la donnée d'un CANDIDAT, pas un document
# d'entreprise. Poser cette clé fait apparaître une option qui envoie le texte
# du CV hors d'ADBI ; l'écran avertit l'utilisateur au moment du choix
# (templates/index.html). Ne la posez que si c'est voulu.
#
# OPENAI_BASE_URL : vide = https://api.openai.com. Si renseignée, ce doit être
# une racine HTTPS, sans chemin ni identifiants (le transport refuse sinon).
# Modèles autorisés : gpt-4.1-nano (défaut) ou gpt-4.1-mini pour le mode rapide,
# gpt-5-nano pour le mode raisonnement. Vide = le défaut du mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELE_RAPIDE=
OPENAI_MODELE_RAISONNEMENT=
# Budget de temps par appel externe. Vide -> DOCIE_TIMEOUT_SECONDS, puis 360.
OPENAI_TIMEOUT_SECONDS=
# Modèles proposés au dépôt et à la ré-analyse de CV (#194,
# document-parsing/models/catalogue.json, tâche `resume`) : identifiant réel de
# chaque modèle, voie texte (mode inline : `store:<nom>`) et voie agent (bridge
# actif, PDF : nom d'agent). Vide = modèle non proposé. Tous vides : comportement
# d'avant (DOCIE_MODEL_PROFILE, DOCIE_AGENT_RESUME, fiche vide de repli). Dès
# qu'un modèle est proposé pour la voie d'un fichier, il part avec le dépôt ou
# la ré-analyse (même règle que contrats) : le sélecteur n'est visible qu'à
# partir de deux, défaut présélectionné. Un modèle choisi n'est jamais remplacé
# et son échec s'affiche tel quel (pas de fiche vide de repli).
DOCIE_MODELE_LFM25_2_6B=
# NuExtract3 (proposé comme « expérimental » pour les CV) : TOUJOURS une
# référence `store:<nom>`. Le déploiement `store:` hérite du `max_tokens` 16384
# de DocIE (#523) ; le profil nommé `nuextract3` de models.yaml fixe encore 4096
# et tronquerait un grand CV (finish_reason: length). Seul `store:` déclenche
# aussi le chargement à la demande (202 `loading`).
DOCIE_MODELE_NUEXTRACT3=
DOCIE_AGENT_RESUME_LFM25_2_6B=
DOCIE_AGENT_RESUME_NUEXTRACT3=
ADBI_MATCHING_MAX_CONCURRENT=2
# Dépôt et ré-analyse de CV (issue #196) : analyses DocIE simultanées, les
# autres attendent en file (20 au plus, 503 au-delà). À aligner sur le
# `n_parallel` du modèle servi pour les CV (liste retenue de #194) : 2 pour
# LFM2.5-2.6B (défaut), 1 pour NuExtract3. Au-delà, les requêtes attendraient
# dans llama-server et cette attente compterait dans DOCIE_TIMEOUT_SECONDS.
# Absente ou vide -> 2 ; entier de 1 à 16, toute autre valeur empêche le
# démarrage. Même nom dans one-pager et contrats ; dans le docker-compose.yml
# racine : CVPARSER_EXTRACTION_MAX_CONCURRENT. L'ancien nom
# ADBI_UPLOAD_MAX_CONCURRENT reste lu quand celui-ci est absent ou vide.
ADBI_EXTRACTION_MAX_CONCURRENT=2
