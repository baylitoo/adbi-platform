# ADBI Parser — variables d'environnement optionnelles.

# Secret JWT (session utilisateur). Si absent, généré au premier lancement
# dans data/jwt_secret.txt et réutilisé ensuite — inutile de le fixer ici en
# développement. À fixer explicitement pour un déploiement multi-instance
# (sinon chaque instance signe avec un secret différent).
ADBI_JWT_SECRET=

# Authentification : désactivée par défaut (poste local). À activer avant
# toute exposition Internet.
ADBI_AUTH=off

# Port et interface d'écoute. ADBI_HOTE=127.0.0.1 par défaut (poste local) ;
# l'image Docker le fixe à 0.0.0.0 (voir Dockerfile), sinon le port publié par
# le conteneur ne serait pas joignable.
PORT=5000
ADBI_HOTE=127.0.0.1

# Débogueur Werkzeug : désactivé par défaut (exécution de code arbitraire si
# jamais exposé — voir app.py). Développement local uniquement.
ADBI_DEBUG=off

# Superuser créé au tout premier démarrage (si data/users.json est vide).
# À définir explicitement avant tout déploiement accessible depuis Internet —
# sinon admin@adbi.fr / Adbi2025! (valeurs de développement, voir config.py).
ADBI_SUPERUSER_EMAIL=
ADBI_SUPERUSER_PASSWORD=

# Fournisseur LLM (extraction de CV) : actuellement OVHcloud AI Endpoints en
# dur (config.py / llm_cascade.py). Passage à une passerelle d'inférence
# auto-hébergée prévu en milestone séparé.
