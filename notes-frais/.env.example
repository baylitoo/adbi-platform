# ADBI Notes de frais — variables d'environnement (valeurs d'exemple uniquement).

PORT=4400

# REQUISE — PostgreSQL partagé ; tables ndf_* créées au démarrage.
#   ex. : postgresql://adbi:<mot-de-passe>@localhost:5432/adbi
DATABASE_URL=

# Contrôle d'accès : même secret que cv-parser ; absent/off = identité locale (poste de dev seulement).
ADBI_AUTH=
ADBI_JWT_SECRET=
# URL publique du hub, ex. https://hub.exemple.test
ADBI_FACTORY_URL=

# Pont DocIE partagé (document-parsing/bridge).
DOCIE_BASE_URL=
DOCIE_API_KEY=
DOCIE_ALLOW_HTTP=
DOCIE_TIMEOUT_SECONDS=360
# Voie agent (photo ou scan) : agent DocIE qui applique le schéma Studio adbi_recu.
DOCIE_AGENT_RECU=adbi_recu
# Voie texte (PDF à couche texte) : profil par défaut si le catalogue ne propose aucun modèle.
DOCIE_MODEL_PROFILE=
# Modèles du catalogue (tâche recu), facultatifs : texte en store:<nom>, agent par nom d'agent.
DOCIE_MODELE_LFM25_2_6B=
DOCIE_MODELE_NUEXTRACT3=
DOCIE_AGENT_RECU_NUEXTRACT3=

# Extractions simultanées, à aligner sur les slots DocIE (défaut 1).
ADBI_EXTRACTION_MAX_CONCURRENT=
