# ADBI Contrats — variables d'environnement.
# Sans ce fichier (copié en .env), les mêmes réglages (hors DATABASE_URL)
# restent saisissables depuis l'écran Paramètres de l'application (écrits
# dans data/secrets.json, hors git). Une variable d'environnement est
# prioritaire sur secrets.json.

PORT=4100

# REQUISE — connexion PostgreSQL (issue #14). Le serveur refuse de démarrer
# sans elle. Le schéma (lib/schema.sql) est appliqué automatiquement
# (CREATE TABLE IF NOT EXISTS, idempotent) au premier démarrage.
#   ex. : postgresql://adbi:<mot-de-passe>@localhost:5432/adbi_contrats
DATABASE_URL=

# Code d'accès à l'écran Paramètres. Sans cette variable, un code par défaut
# est écrit dans data/code-parametres.txt au premier démarrage — à définir
# explicitement avant tout déploiement accessible depuis Internet.
ADBI_CODE_PARAMETRES=

# Recherche société : gouv.fr est utilisé par défaut, sans clé.
# Renseigner l'une de ces deux clés pour basculer sur Pappers ou INSEE Sirene.
PAPPERS_API_KEY=
INSEE_API_KEY=

# Envoi des invitations de signature (sans SMTP : repli sur liens/mailto manuels).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Signature électronique — Yousign (connecteur par défaut).
YOUSIGN_API_KEY=
YOUSIGN_MODE=sandbox
YOUSIGN_WEBHOOK_SECRET=

# Signature électronique — Zoho Sign (alternative, région UE par défaut).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REGION=eu
ZOHO_WEBHOOK_SECRET=

# Extraction Kbis et URSSAF via le bridge DocIE partagé
# (document-parsing/bridge/) — issues #153 et #170. Désactivée par défaut :
# analyse 100% locale (pdf-parse + tesseract.js, sans envoi externe,
# lib/docanalyze.js) inchangée. Deux pièces, deux voies (voir
# lib/docie-extraction.js) :
#   - Kbis   : voie agent, le document part entier, l'agent résout son schéma
#              PAR NOM -> DOCIE_AGENT_KBIS ci-dessous, et un schéma enregistré
#              côté Studio DocIE.
#   - URSSAF : voie texte, la couche texte du PDF est lue localement puis
#              envoyée avec la DÉFINITION du schéma dans le corps de la requête
#              (document-parsing/schemas/urssaf.schema.json). Rien à
#              enregistrer côté Studio, AUCUN agent à configurer. Une
#              attestation scannée (image, ou PDF dont une page est sans texte)
#              n'est jamais envoyée : analyse locale, avec un avertissement.
# Les cinq autres pièces (RIB, CNI, attestation fiscale, coordonnées,
# informations spécifiques) restent toujours locales, flag ou pas : elles n'ont
# ni schéma ni mapping à ce jour. Sur échec DocIE (config manquante, timeout,
# erreur upstream...), repli automatique sur l'analyse locale.
#
# Même flag pour le pré-remplissage de l'import de contrat depuis un document
# (POST /api/contracts/importer/extraire, schéma DocIE "contract" — voir
# lib/docie-contract-import.js) : pas de repli local ici (aucune analyse
# locale équivalente à 19 champs structurés), flag off = fonctionnalité
# simplement absente, saisie manuelle comme aujourd'hui.
DOCIE_EXTRACTION_ENABLED=false
# Racine API DocIE (sans /v1), clé serveur et agents Kbis/Contrat — requis
# uniquement si DOCIE_EXTRACTION_ENABLED=true. Voir document-parsing/bridge/README.md.
DOCIE_BASE_URL=
DOCIE_API_KEY=
DOCIE_AGENT_KBIS=
# Agent DocIE pour le schéma "contract" (pré-remplissage de l'import) — à
# configurer côté DocIE, requis uniquement pour /api/contracts/importer/extraire.
DOCIE_AGENT_CONTRACT=
# DocIE joint en http:// sur un réseau privé de confiance (hors localhost) :
# le bridge refuse sans DOCIE_ALLOW_HTTP=true, et TOUTES les extractions
# DocIE de ce service (Kbis, URSSAF, import de contrat) échouent en
# « configuration » avant le moindre appel.
DOCIE_ALLOW_HTTP=
# Délai client d'une extraction DocIE, en secondes (1 à 3600, défaut 360).
DOCIE_TIMEOUT_SECONDS=360

# Délais (ms) des appels HTTP sortants vers les fournisseurs externes
# (Yousign, Zoho Sign, recherche société gouv.fr/Pappers/INSEE). Défauts :
# 15 s pour un appel API classique, 60 s pour l'envoi/téléchargement d'un
# document (PDF du contrat). À ajuster seulement si un fournisseur s'avère
# systématiquement plus lent que ces délais.
ADBI_DELAI_HTTP_MS=15000
ADBI_DELAI_UPLOAD_MS=60000
